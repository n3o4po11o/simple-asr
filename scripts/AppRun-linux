#!/bin/sh
# simple-asr AppImage 启动器（linuxdeploy --custom-apprun）
# 关键：Flutter bundle 的 Rust dylib(libasr_bridge.so) 由 Dart 侧按裸名 dlopen，
# glibc 对裸名使用「调用方对象」的 RUNPATH 而非主程序，故必须把 bundle 的
# lib 目录放进 LD_LIBRARY_PATH。
HERE="$(dirname "$(readlink -f "$0")")"
export LD_LIBRARY_PATH="$HERE/usr/lib:$HERE/usr/bin/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Vulkan loader 宿主优先（loader 与 ICD 是发行版配套关系，混版本会 NULL
# 函数指针段错误）：宿主有 loader 就用宿主的；没有（必然也没有 ICD，无错配
# 可能）才启用包内 fallback（引擎 CPU 回退路径）。
LDCONFIG="$(command -v ldconfig || echo /sbin/ldconfig)"
if ! "$LDCONFIG" -p 2>/dev/null | grep -q "libvulkan.so.1"; then
  export LD_LIBRARY_PATH="$HERE/usr/bin/lib-vulkan-fallback:$LD_LIBRARY_PATH"
fi

exec "$HERE/usr/bin/simple_asr" "$@"
